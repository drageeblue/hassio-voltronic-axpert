name: "Axpert Inverter"
description: "Monitors an axpert inverter"
url: https://github.com/drageeblue/hassio-voltronic-axpert
version: "0.5.1"
slug: "axpert"
init: false
host_dbus: true
apparmor: true

startup: "application"
boot: "auto"
privileged: ["SYS_RAWIO"]
uart: true
usb: true

homeassistant_api: true # http://supervisor/core/api
hassio_api: true        # http://supervisor

# watchdog: true # todo  https://developers.home-assistant.io/docs/add-ons/configuration/

arch:
  - aarch64
  - amd64
  - armhf
  - armv7
  - i386

services:
  - mqtt:need

discovery:
  - mqtt

options:
  device: "/dev/hidraw0",
  mqtt_server: "192.168.1.231",
  mqtt_user: "pbc",
  mqtt_pass: "Aa1361336",
  mqtt_client_id: "axpert0",
  mqtt_topic_parallel: "inverter/axpert",
  mqtt_topic_settings: "inverter/axpert_settings",
  mqtt_topic: "inverter/axpert{sn}"

schema:
  device: "str",
  mqtt_server: "str",
  mqtt_user: "str",
  mqtt_pass: "str",
  mqtt_client_id: "str",
  mqtt_topic_parallel: "str",
  mqtt_topic_settings: "str",
  mqtt_topic: "str"
  
